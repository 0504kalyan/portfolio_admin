# Portfolio admin settings. Copy to .env.local for local development; never commit real values.
# In production, set these in Vercel → (admin project) → Settings → Environment Variables.
# None use the VITE_ prefix, so none of them ever reach the browser.
# JSON values go in single quotes in .env files.

# --- The portfolios this admin manages (required) ---
# id: short key used in admin URLs · url: the live portfolio · repo: its GitHub "owner/name"
# Optional per site: branch (main), contentPath, schemaPath, uploadDir, tokenEnv (GITHUB_TOKEN),
# deployHookEnv, localPath (local development only).
SITES='[
  {"id":"pavan","name":"Pavan Kalyan Kama","url":"https://portfolio-of-pavan.vercel.app","repo":"0504kalyan/PortFolio","localPath":"../my portfolio"},
  {"id":"koti","name":"Koteswara Rao Doppalapudi","url":"https://koti-potifoli.vercel.app","repo":"0504kalyan/koti_potifoli","localPath":"../koti portfolio"}
]'

# --- GitHub access (required in production) ---
# One fine-grained token with "Contents: Read and write" on every portfolio repo above.
# To use a separate token for a site, set "tokenEnv":"GITHUB_TOKEN_KOTI" on it and add that variable.
GITHUB_TOKEN=

# --- Who can sign in (required) ---
# Each user lists the site ids they may edit ("*" = all). Hashes come from `npm run hash-password`.
ADMIN_USERS='[
  {"username":"pavan","passwordHash":"scrypt:...","sites":["*"]},
  {"username":"koti","passwordHash":"scrypt:...","sites":["koti"]}
]'
# Or, for a single admin with access to every site, instead of ADMIN_USERS:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt:...

# 32+ random characters (printed by `npm run hash-password`). Changing it signs everyone out.
SESSION_SECRET=

# --- Local development only (ignored on Vercel) ---
# "local": read and write each site's `localPath` folder instead of GitHub, so the portfolio's
# own `npm run dev` shows saved changes at once.
CONTENT_STORE=local
